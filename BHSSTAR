<script>

/* =========================
   DATE
========================= */

const today = new Date();

const dateOptions = {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric"
};

document.getElementById("date").textContent =
    today.toLocaleDateString("en-US", dateOptions);

document.getElementById("dayMessage").textContent =
    "Today is a new day to learn, grow, and do your best! 🌸";


/* =========================
   WEATHER
========================= */

function getWeather() {

    const description =
        document.getElementById("weatherDescription");

    description.textContent =
        "Getting your weather...";

    if (!navigator.geolocation) {

        description.textContent =
            "Your browser does not support location services.";

        return;
    }

    navigator.geolocation.getCurrentPosition(

        async function(position) {

            const latitude =
                position.coords.latitude;

            const longitude =
                position.coords.longitude;

            try {

                const response =
                    await fetch(
                        `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,weather_code&temperature_unit=fahrenheit`
                    );

                const data =
                    await response.json();

                const temperature =
                    Math.round(
                        data.current.temperature_2m
                    );

                document.getElementById(
                    "temperature"
                ).textContent =
                    temperature + "°F";

                const code =
                    data.current.weather_code;

                let icon = "🌤️";
                let text = "Partly cloudy";

                if (code === 0) {

                    icon = "☀️";
                    text = "Clear skies";

                } else if (code <= 3) {

                    icon = "⛅";
                    text = "Partly cloudy";

                } else if (code >= 51 && code <= 67) {

                    icon = "🌧️";
                    text = "Rain";

                } else if (code >= 71 && code <= 77) {

                    icon = "❄️";
                    text = "Snow";

                } else if (code >= 80 && code <= 82) {

                    icon = "🌦️";
                    text = "Rain showers";

                } else if (code >= 95) {

                    icon = "⛈️";
                    text = "Thunderstorms";

                }

                document.getElementById(
                    "weatherIcon"
                ).textContent = icon;

                description.textContent = text;

            } catch (error) {

                description.textContent =
                    "Weather could not be loaded.";

            }

        },

        function() {

            description.textContent =
                "Please allow location access to see the weather.";

        }

    );
}


/* =========================
   SCHEDULE
========================= */

function toggleTask(checkbox) {

    const text =
        checkbox.nextElementSibling;

    if (checkbox.checked) {

        text.classList.add("completed");

    } else {

        text.classList.remove("completed");

    }

}


/* =========================
   GOAL
========================= */

function completeGoal() {

    document.getElementById(
        "goalStatus"
    ).textContent =
        "🎉 Great job! You completed today's goal!";

}


/* =========================
   FEELINGS
========================= */

function setFeeling(feeling) {

    document.getElementById(
        "feelingResult"
    ).textContent =
        "You selected: " + feeling + " 💕";

}


/* =========================
   QUESTION
========================= */

function answerQuestion(answer) {

    document.getElementById(
        "answer"
    ).textContent =
        "Your answer: " + answer;

}


/* =========================
   BRAIN BREAK
========================= */

const brainBreaks = [

    "🙆 Stand up and stretch your arms to the sky!",

    "🌬️ Take 5 slow, deep breaths.",

    "⭐ Do 10 jumping jacks!",

    "🧘 Stretch your arms and touch your toes.",

    "🚶 Walk around the room for 30 seconds.",

    "👋 Shake your hands and arms!",

    "👀 Look around and name 5 things you can see.",

    "💧 Take a drink of water.",

    "💃 Dance for 20 seconds!",

    "🌸 Close your eyes and take three deep breaths."

];


function newBrainBreak() {

    const random =
        Math.floor(
            Math.random() * brainBreaks.length
        );

    document.getElementById(
        "brainBreak"
    ).textContent =
        brainBreaks[random];

}


/* =========================
   TIMER
========================= */

let timerSeconds = 300;

let timerInterval = null;


function updateTimer() {

    const minutes =
        Math.floor(timerSeconds / 60);

    const seconds =
        timerSeconds % 60;

    const displayMinutes =
        String(minutes).padStart(2, "0");

    const displaySeconds =
        String(seconds).padStart(2, "0");

    document.getElementById(
        "timer"
    ).textContent =
        displayMinutes + ":" + displaySeconds;

}


function setTimer(minutes) {

    clearInterval(timerInterval);

    timerInterval = null;

    timerSeconds =
        minutes * 60;

    updateTimer();

}


function startTimer() {

    if (timerInterval !== null) {
        return;
    }

    timerInterval =
        setInterval(function() {

            if (timerSeconds <= 0) {

                clearInterval(timerInterval);

                timerInterval = null;

                alert("⏰ Time is up! Great job!");

                return;
            }

            timerSeconds--;

            updateTimer();

        }, 1000);

}


function pauseTimer() {

    clearInterval(timerInterval);

    timerInterval = null;

}


function resetTimer() {

    clearInterval(timerInterval);

    timerInterval = null;

    timerSeconds = 300;

    updateTimer();

}


/* =========================
   READ ALOUD
========================= */

function readElement(...ids) {

    stopReading();

    let text = "";

    ids.forEach(function(id) {

        const element =
            document.getElementById(id);

        if (element) {

            text +=
                element.innerText + " ";

        }

    });

    speak(text);

}


function readPage() {

    stopReading();

    speak(
        document.body.innerText
    );

}


function speak(text) {

    const speech =
        new SpeechSynthesisUtterance(text);

    speech.rate = .85;

    speech.pitch = 1;

    window.speechSynthesis.speak(
        speech
    );

}


function stopReading() {

    window.speechSynthesis.cancel();

}


/* =========================
   TOOLS
========================= */

function openTool(url) {

    window.open(
        url,
        "_blank",
        "noopener,noreferrer"
    );

}


/* =========================
   CURRENT EVENTS
========================= */

function showNews(category) {

    const news =
        document.getElementById("news");

    const topics = {

        general: {
            title: "🌎 General News",
            description:
                "Look for a news story about something happening in the United States or around the world."
        },

        science: {
            title: "🔬 Science News",
            description:
                "Science news can teach us about space, animals, Earth, medicine, technology, and new discoveries."
        },

        technology: {
            title: "💻 Technology News",
            description:
                "Technology news can teach us about computers, phones, artificial intelligence, inventions, and new tools."
        },

        sports: {
            title: "🏀 Sports News",
            description:
                "Sports news can help us learn about teams, athletes, scores, and upcoming events."
        }

    };

    const topic =
        topics[category];

    news.innerHTML = `

        <div class="news-item">

            <h3>${topic.title}</h3>

            <p>
                ${topic.description}
            </p>

            <a
                href="https://news.google.com"
                target="_blank"
                rel="noopener noreferrer">

                Read Today's News →

            </a>

        </div>

    `;

}


/* =========================
   START
========================= */

updateTimer();

getWeather();

</script>

